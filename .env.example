# Which AI backend to use: auto | claude_cli | gemini
#   auto       -> Claude Code CLI if installed (local, uses your Claude Pro plan), else Gemini
#   claude_cli -> personal/local use only
#   gemini     -> public deployment (LinkedIn demo)
LLM_PROVIDER=auto

# Claude Code CLI (local). Model alias: sonnet | opus | haiku
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_SECONDS=180

# Gemini free tier: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash,gemini-flash-latest,gemini-flash-lite-latest

# SEC EDGAR asks for a descriptive User-Agent; add your contact email, e.g. "StoryNumbers you@example.com"
SEC_USER_AGENT=
